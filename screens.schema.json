{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "screens.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updated",
    "items"
  ],
  "properties": {
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date de la dernière modification des données"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "release",
          "url",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "type": {
            "enum": [
              "film",
              "serie"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "originalTitle": {
            "type": "string",
            "minLength": 1
          },
          "season": {
            "type": "integer",
            "minimum": 1
          },
          "release": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Sortie en salle ou première diffusion en France"
          },
          "releaseEnd": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Séries : dernier épisode, si le calendrier est publié"
          },
          "genres": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "people": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "directors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "creators": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cast": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "maxItems": 6
              }
            }
          },
          "where": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind",
                "free",
                "source"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "cinema",
                    "streaming",
                    "tv"
                  ]
                },
                "free": {
                  "type": "boolean"
                },
                "confirmed": {
                  "type": "boolean",
                  "description": "false si la disponibilité en France n'est pas confirmée"
                },
                "source": {
                  "type": "string",
                  "pattern": "^https?://"
                }
              }
            }
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "source": {
            "type": "string",
            "pattern": "^https?://"
          },
          "tentative": {
            "type": "boolean",
            "description": "Date annoncée mais pas fixée (fenêtre de sortie)"
          }
        }
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "detail",
          "since"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "missing",
              "uncertain"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "since": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
